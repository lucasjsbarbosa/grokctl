    "xai",
    "cli",
    "claude-code",
    "codex",
    "opencode",
    "maestri",
    "multi-agent",
    "ai-agents",
    "agent-orchestration",
    "chrome-devtools-protocol",
    "electron",
    "automation",
    "wsl"
  ]
}
